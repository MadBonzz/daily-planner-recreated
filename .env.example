# For hosted forecasts and chat, set COHERE_API to your key.
PLANNER_MODEL_ENDPOINT=https://api.cohere.ai/compatibility/v1/chat/completions
PLANNER_MODEL=command-r7b-12-2024
COHERE_API=

# For local inference, replace the endpoint and model lines above:
# PLANNER_MODEL_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
# PLANNER_MODEL=ternary-bonsai-4b

# For one-at-a-time local models on a Mac with Bionic serving port 1235,
# run `bash run-bionic-mac.sh` from the repo. It sets PLANNER_SINGLE_MODEL=1,
# the local IDs and endpoints for its process; the hosted defaults above still
# apply to ordinary launches. See “Run locally on an Apple Silicon Mac” in the README.
#
# Optional context overrides for the local launcher:
# PLANNER_EMBEDDING_CONTEXT_LENGTH=2048
# PLANNER_DECISION_CONTEXT_LENGTH=4096
# PLANNER_CHAT_CONTEXT_LENGTH=8192

# Optional overrides for ActivityWatch SQLite stores. The native macOS and Windows
# aw-server-rust stores are discovered automatically. A synced phone file on macOS
# can be set with an absolute path such as /Users/you/Sync/ActivityWatch/test.db.
# PLANNER_ACTIVITYWATCH_DB=D:/ActivityWatch/laptop/sqlite.db
# PLANNER_ACTIVITYWATCH_PHONE_DB=D:/ActivityWatchSync/phone/test.db
# PLANNER_ACTIVITYWATCH_HOSTNAME=MY-LAPTOP

# Local LM Studio retrieval and pairwise relevance decisions (also used with hosted forecasts).
# PLANNER_EMBEDDING_ENDPOINT=http://127.0.0.1:1234/v1/embeddings
# PLANNER_EMBEDDING_MODEL=qwen3-embedding-0.6b
# PLANNER_DECISION_ENDPOINT=http://127.0.0.1:1234/v1/systemone
# PLANNER_DECISION_MODEL=kev-4b
# Minimum automatic cosine similarity is 0.50. Increase to narrow the candidate pool.
# PLANNER_RELEVANCE_THRESHOLD=0.50
