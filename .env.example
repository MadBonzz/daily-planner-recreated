# Copy the two active lines into your existing .env and keep your own COHERE_API.
PLANNER_MODEL_ENDPOINT=https://api.cohere.ai/compatibility/v1/chat/completions
PLANNER_MODEL=command-r7b-12-2024
COHERE_API=

# For local inference, replace the endpoint and model lines above:
# PLANNER_MODEL_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
# PLANNER_MODEL=ternary-bonsai-4b

# Optional overrides for ActivityWatch SQLite stores (Windows defaults are discovered).
# PLANNER_ACTIVITYWATCH_DB=D:/ActivityWatch/laptop/sqlite.db
# PLANNER_ACTIVITYWATCH_PHONE_DB=D:/ActivityWatchSync/phone/test.db
# PLANNER_ACTIVITYWATCH_HOSTNAME=MY-LAPTOP
